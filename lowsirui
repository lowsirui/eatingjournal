<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Eating Journal</title>
<style>
@font-face{font-family:"Fredoka";font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fredoka";font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Fredoka";font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Patrick Hand";font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
</style>
<style>
:root{
  --bg:#e9eefa; --dot:#c9d3ee; --ink:#3a3450; --soft:#6d6784; --btn:#7a5cc7; --btn-ink:#fff;
  --card:#fffdf8; --line:rgba(58,52,80,.14); --shadow:0 6px 0 rgba(58,52,80,.08), 0 10px 24px rgba(58,52,80,.10);
  --n0:#fff1b3; --n1:#ffd6e1; --n2:#cfeedd; --n3:#d3e5ff; --field:rgba(255,255,255,.6);
  --head:"Fredoka",ui-rounded,"Nunito","Trebuchet MS",system-ui,sans-serif; --hand:"Patrick Hand","Chalkboard SE",ui-rounded,"Trebuchet MS",system-ui,sans-serif;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#1d1a2b; --dot:#2b2740; --ink:#efeaff; --soft:#b3abd0; --btn:#a58bf0; --btn-ink:#1d1a2b;
    --card:#2a2640; --line:rgba(239,234,255,.16); --shadow:0 6px 0 rgba(0,0,0,.25);
    --n0:#4a4326; --n1:#4d2f3b; --n2:#2b4a3c; --n3:#2c405f; --field:rgba(0,0,0,.22); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1d1a2b; --dot:#2b2740; --ink:#efeaff; --soft:#b3abd0; --btn:#a58bf0; --btn-ink:#1d1a2b;
  --card:#2a2640; --line:rgba(239,234,255,.16); --shadow:0 6px 0 rgba(0,0,0,.25);
  --n0:#4a4326; --n1:#4d2f3b; --n2:#2b4a3c; --n3:#2c405f; --field:rgba(0,0,0,.22); color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);background-image:radial-gradient(var(--dot) 1.4px,transparent 1.6px);background-size:22px 22px;color:var(--ink);font-family:var(--hand);font-size:19px;line-height:1.35;min-height:100vh}
.wrap{max-width:560px;margin:0 auto;padding:22px 16px 80px}
h1,h2,h3,.btn{font-family:var(--head)}
.hero{text-align:center;padding:14px 0 10px}
.badge{display:inline-grid;place-items:center;width:72px;height:72px;border-radius:50%;background:var(--n1);font-size:36px;box-shadow:var(--shadow);transform:rotate(-6deg)}
h1{font-size:2.3rem;font-weight:600;margin:12px 0 2px;letter-spacing:-.01em}
.sub{margin:0;color:var(--soft)}
.actions{display:grid;grid-template-columns:1fr;gap:12px;margin:22px 0 26px}
.btn{appearance:none;border:0;border-radius:18px;padding:15px 18px;font-size:1.12rem;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;color:var(--ink);background:var(--card);box-shadow:var(--shadow);transition:transform .12s}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(58,52,80,.1)}
.btn.primary{background:var(--btn);color:var(--btn-ink)}
.btn:focus-visible,.dd-btn:focus-visible,.back:focus-visible{outline:3px solid var(--btn);outline-offset:3px}
.empty{text-align:center;color:var(--soft);padding:26px 10px;border:2px dashed var(--line);border-radius:20px}
.note{position:relative;border-radius:6px 6px 18px 18px;padding:26px 16px 16px;margin:0 0 22px;box-shadow:var(--shadow);background:var(--n0)}
.note.c1{background:var(--n1)}.note.c2{background:var(--n2)}.note.c3{background:var(--n3)}
.note::before{content:"";position:absolute;top:-10px;left:50%;width:84px;height:22px;transform:translateX(-50%) rotate(-3deg);background:repeating-linear-gradient(135deg,rgba(255,255,255,.7) 0 6px,rgba(255,255,255,.35) 6px 12px);border-radius:3px;opacity:.9}
.note.new{animation:slidein .7s cubic-bezier(.2,.9,.25,1.15) both}
@keyframes slidein{0%{opacity:0;transform:translate(-110%,-20px) rotate(-14deg)}60%{opacity:1;transform:translate(6px,0) rotate(2deg)}100%{opacity:1;transform:none}}
.field{margin:0 0 12px}
.field label,.field .lab{display:block;font-family:var(--head);font-weight:500;font-size:.88rem;color:var(--soft);margin:0 0 4px}
.in{width:100%;border:0;border-radius:12px;background:var(--field);padding:9px 11px;font:inherit;color:var(--ink);resize:none;overflow:hidden;min-height:44px;display:block}
.in:focus{outline:2px solid var(--btn);background:var(--card)}
.in::placeholder{color:var(--soft);opacity:.7}
.dd-btn{width:100%;text-align:left;border:0;border-radius:12px;background:var(--field);padding:6px 11px;font:inherit;color:var(--ink);display:flex;justify-content:space-between;align-items:center;cursor:pointer;min-height:34px}
.ph{font-size:.8rem;color:var(--soft)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}
.chip{background:var(--card);border-radius:99px;padding:4px 14px;font-size:1.08rem;box-shadow:0 2px 0 rgba(58,52,80,.1)}
.panel{margin-top:6px;background:var(--card);border-radius:14px;padding:6px 10px;box-shadow:var(--shadow)}
.panel[hidden]{display:none}
.opt{display:flex;align-items:center;gap:10px;padding:8px 2px;border-bottom:1px dashed var(--line);cursor:pointer}
.opt input{width:20px;height:20px;accent-color:var(--btn);flex:none}
.opt.other{border-bottom:0}
.opt.other .in{background:var(--field);padding:6px 9px;min-height:36px}
.del{appearance:none;border:0;background:none;color:var(--soft);font:inherit;cursor:pointer;padding:6px 2px;float:right}
.del:hover{color:var(--ink);text-decoration:underline}
.back{appearance:none;border:0;background:none;font-family:var(--head);font-size:1rem;color:var(--btn);cursor:pointer;padding:8px 0}
.guides{display:grid;gap:14px;margin-top:14px}
.guide{border-radius:20px;padding:18px 18px;text-align:left;font-size:1.25rem;cursor:pointer;border:0;color:var(--ink);box-shadow:var(--shadow);display:flex;gap:14px;align-items:center;font-family:var(--head);font-weight:500}
.guide:active{transform:translateY(3px)}
.guide .em{font-size:1.7rem}
.view[hidden]{display:none}
.overlay{position:fixed;inset:0;background:rgba(30,25,50,.5);display:grid;place-items:center;padding:20px;z-index:20;animation:fade .2s both}
.overlay[hidden]{display:none}
.pop{width:100%;max-width:440px;max-height:82vh;overflow:auto;border-radius:22px;padding:26px 22px 22px;box-shadow:var(--shadow);animation:pop .35s cubic-bezier(.2,1.3,.4,1) both;position:relative}
@keyframes pop{from{opacity:0;transform:scale(.8) rotate(-3deg)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
.pop h2{margin:0 0 12px;font-size:1.5rem;font-weight:600}
.pop p{margin:0 0 12px}
.pop ul{margin:0;padding-left:0;list-style:none}
.pop li{padding:6px 0;border-bottom:1px dashed var(--line)}
.pop li:last-child{border:0}
.pop .k{font-family:var(--head);font-weight:600}
.pop .close{margin:12px auto 0;width:auto;padding:7px 22px;font-size:.95rem;border-radius:14px}
@media (prefers-reduced-motion:reduce){.note.new,.pop,.overlay{animation:none}}
@media (min-width:480px){.actions{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wrap">
  <section id="home" class="view">
    <header class="hero">
      <div class="badge" aria-hidden="true">🍓</div>
      <h1>Eating Journal</h1>
      <p class="sub">A gentle place to notice what’s going on.</p>
    </header>
    <div class="actions">
      <button class="btn primary" id="newBtn">✏️ New note</button>
      <button class="btn" id="guideBtn">📖 Guidebook</button>
    </div>
    <div id="notes"></div>
  </section>

  <section id="guide" class="view" hidden>
    <button class="back" id="backBtn">‹ Back to journal</button>
    <header class="hero" style="padding-top:4px">
      <h1>Guidebook</h1>
      <p class="sub">Tap a card to open it.</p>
    </header>
    <div class="guides" id="guides"></div>
  </section>
</div>

<div class="overlay" id="overlay" hidden>
  <div class="pop" id="pop" role="dialog" aria-modal="true" aria-labelledby="popTitle"></div>
</div>

<script>
(function(){
  var KEY="eating-journal-notes-v1";
  var FACTORS=["Not enough sleep","Physically unwell","Haven’t eaten in a long time","Stress","Being lonely or isolated","Not enough movement or exercise","Traumatic experiences"];
  var FIELDS=[["event","Prompting Event"],["thoughts","Thoughts"],["emotions","Emotions"],["sensations","Physical Sensations"],["urges","Urges"],["behaviour","Behaviour"]];
  var notes=[];
  try{var raw=localStorage.getItem(KEY);if(raw)notes=JSON.parse(raw)||[];}catch(e){notes=[];}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(notes));}catch(e){}}
  function today(){var d=new Date(),p=function(x){return String(x).padStart(2,"0");};return d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate())+"T"+p(d.getHours())+":"+p(d.getMinutes());}
  function el(t,c,txt){var e=document.createElement(t);if(c)e.className=c;if(txt!=null)e.textContent=txt;return e;}
  function grow(t){t.style.height="auto";t.style.height=t.scrollHeight+"px";}

  var list=document.getElementById("notes");

  function emptyMsg(){
    var has=list.querySelector(".note"),m=list.querySelector(".empty");
    if(!has&&!m){list.appendChild(el("div","empty","No notes yet. Tap “New note” to write your first one."));}
    if(has&&m)m.remove();
  }

  function makeNote(n,animate){
    var card=el("article","note c"+(n.color%4)+(animate?" new":""));
    var del=el("button","del","Delete");del.type="button";
    var armed=false,tm;
    del.onclick=function(){
      if(!armed){armed=true;del.textContent="Tap again to delete";del.style.color="var(--ink)";tm=setTimeout(function(){armed=false;del.textContent="Delete";del.style.color="";},3000);return;}
      clearTimeout(tm);notes=notes.filter(function(x){return x.id!==n.id;});save();card.remove();emptyMsg();
    };
    card.appendChild(del);

    var f=el("div","field");var l=el("label",null,"Date");l.htmlFor="d"+n.id;f.appendChild(l);
    var d=el("input","in");d.type="datetime-local";d.id="d"+n.id;d.value=(n.date&&n.date.length===10)?n.date+"T12:00":n.date;
    d.oninput=function(){n.date=d.value;save();};f.appendChild(d);card.appendChild(f);

    function textField(k,label){
      var w=el("div","field");var lb=el("label",null,label);lb.htmlFor=k+n.id;w.appendChild(lb);
      var t=el("textarea","in");t.id=k+n.id;t.rows=1;t.value=n[k]||"";
      t.oninput=function(){n[k]=t.value;grow(t);save();};w.appendChild(t);return [w,t];
    }
    var tas=[];
    var first=textField(FIELDS[0][0],FIELDS[0][1]);card.appendChild(first[0]);tas.push(first[1]);

    // vulnerability factors
    var vf=el("div","field");vf.appendChild(el("span","lab","Vulnerability Factors"));
    var btn=el("button","dd-btn");btn.type="button";btn.setAttribute("aria-expanded","false");
    var bl=el("span","ph","Choose any that apply");var car=el("span",null,"▾");btn.appendChild(bl);btn.appendChild(car);
    var chips=el("div","chips");
    var panel=el("div","panel");panel.hidden=true;
    function drawChips(){
      chips.textContent="";
      n.factors.forEach(function(x){chips.appendChild(el("span","chip",x));});
      if(n.custom&&n.custom.trim())chips.appendChild(el("span","chip",n.custom.trim()));
    }
    FACTORS.forEach(function(name){
      var o=el("label","opt");var cb=el("input");cb.type="checkbox";cb.checked=n.factors.indexOf(name)>-1;
      cb.onchange=function(){
        n.factors=n.factors.filter(function(x){return x!==name;});
        if(cb.checked)n.factors.push(name);
        n.factors.sort(function(a,b){return FACTORS.indexOf(a)-FACTORS.indexOf(b);});
        save();drawChips();
      };
      o.appendChild(cb);o.appendChild(el("span",null,name));panel.appendChild(o);
    });
    var oo=el("div","opt other");var ob=el("span",null,"✎");
    var ci=el("input","in");ci.type="text";ci.placeholder="Something else…";ci.value=n.custom||"";ci.setAttribute("aria-label","Other vulnerability factor");
    ci.oninput=function(){n.custom=ci.value;save();drawChips();};
    oo.appendChild(ob);oo.appendChild(ci);panel.appendChild(oo);
    btn.onclick=function(){
      panel.hidden=!panel.hidden;btn.setAttribute("aria-expanded",String(!panel.hidden));car.textContent=panel.hidden?"▾":"▴";
    };
    vf.appendChild(btn);vf.appendChild(panel);vf.appendChild(chips);card.appendChild(vf);drawChips();

    FIELDS.slice(1).forEach(function(p){var r=textField(p[0],p[1]);card.appendChild(r[0]);tas.push(r[1]);});
    card._grow=function(){tas.forEach(grow);};
    return card;
  }

  function render(){
    list.textContent="";
    notes.forEach(function(n){var c=makeNote(n,false);list.appendChild(c);c._grow();});
    emptyMsg();
  }

  document.getElementById("newBtn").onclick=function(){
    var n={id:Date.now(),color:notes.length?(notes[0].color+1)%4:0,date:today(),event:"",factors:[],custom:"",thoughts:"",emotions:"",sensations:"",urges:"",behaviour:""};
    notes.unshift(n);save();
    var m=list.querySelector(".empty");if(m)m.remove();
    var c=makeNote(n,true);list.insertBefore(c,list.firstChild);c._grow();
    window.scrollTo({top:0,behavior:window.matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});
  };

  // guidebook
  var GUIDES=[
    {t:"Managing emotions",e:"🌦️",c:"n3",pairs:[["Boredom","Do something meaningful."],["Anxiety","Practice mindfulness and tolerate the uncomfortable sensation."],["Loneliness","Contact someone."],["Stress","Take a break or do something fun."]]},
    {t:"3 states of mind",e:"🧠",c:"n1",pairs:[["Emotional mind","“I’m sad. I want cookies.”"],["Logical mind","“I should ignore the urge.”"],["Wise mind","“I acknowledge that I’m sad and I’m craving cookies. I know what I really need and I can choose how to respond.”"]]},
    {t:"A question to ask yourself",e:"💭",c:"n0",text:["What would be the most effective way to respond to this craving right now?","Do I want to just give myself a treat? Or is there a deeper emotional issue?"]},
    {t:"Build positive experiences",e:"🌼",c:"n2",items:["Listen to music","Watch a show","Spend time with friends","Go for a walk","Read a book","Have a relaxing shower","Pursue a hobby","Go outdoors","Spend time with animals"]},
    {t:"Half-Smiling Technique",e:"🙂",c:"n1",text:["Doing a half-smile isn’t about forcing yourself to be happy or pretending everything is fine. It’s about adopting a non-hostile, receptive posture towards the present moment."]}
  ];
  var gl=document.getElementById("guides"),ov=document.getElementById("overlay"),pop=document.getElementById("pop"),lastFocus=null;
  GUIDES.forEach(function(g){
    var b=el("button","guide");b.type="button";b.style.background="var(--"+g.c+")";
    b.appendChild(el("span","em",g.e));b.appendChild(el("span",null,g.t));
    b.onclick=function(){openPop(g,b);};gl.appendChild(b);
  });
  function openPop(g,from){
    lastFocus=from;pop.textContent="";pop.style.background="var(--"+g.c+")";
    var h=el("h2",null,g.t);h.id="popTitle";pop.appendChild(h);
    if(g.pairs){var ul=el("ul");g.pairs.forEach(function(p){var li=el("li");li.appendChild(el("span","k",p[0]+": "));li.appendChild(document.createTextNode(p[1]));ul.appendChild(li);});pop.appendChild(ul);}
    if(g.text)g.text.forEach(function(t){pop.appendChild(el("p",null,t));});
    if(g.items){var u=el("ul");g.items.forEach(function(t){u.appendChild(el("li",null,"• "+t));});pop.appendChild(u);}
    var cb=el("button","btn close","Close");cb.type="button";cb.onclick=closePop;pop.appendChild(cb);
    ov.hidden=false;cb.focus();
  }
  function closePop(){ov.hidden=true;if(lastFocus)lastFocus.focus();}
  ov.addEventListener("click",function(e){if(e.target===ov)closePop();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!ov.hidden)closePop();});

  // routing: #guidebook or home
  function show(g){
    document.getElementById("home").hidden=g;document.getElementById("guide").hidden=!g;
    if(!g)document.querySelectorAll("textarea").forEach(grow);
    window.scrollTo(0,0);
  }
  function route(){show(location.hash==="#guidebook");}
  document.getElementById("guideBtn").onclick=function(){show(true);try{history.pushState(null,"","#guidebook");}catch(e){}};
  document.getElementById("backBtn").onclick=function(){show(false);try{history.pushState(null,"",location.pathname+location.search);}catch(e){}};
  window.addEventListener("popstate",route);
  window.addEventListener("hashchange",route);

  render();route();
})();
</script>
</body>
</html>
